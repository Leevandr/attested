# Copy to .env and export the variables you want. No secrets are needed for the demo.
#
# Optional: a NEAR AI Cloud API key (https://cloud.near.ai). With it, `ask` and
# `npm run demo:live` run a REAL non-streaming chat on a Confidential TEE model and verify the
# response signature. Without it, `ask` runs in clearly labelled RECORDED mode.
NEAR_AI_API_KEY=

# Optional overrides
# NEAR_AI_MODEL=Qwen/Qwen3.8-27B
# NEAR_AI_BASE_URL=https://cloud-api.near.ai

# Optional, testnet anchoring only (a THROWAWAY *.testnet account; keep the key file OUTSIDE this repo)
# ATTESTED_REGISTRY_CONTRACT=
# ATTESTED_ACCOUNT=
# ATTESTED_KEY_FILE=
# ATTESTED_RPC_URL=https://test.rpc.fastnear.com
